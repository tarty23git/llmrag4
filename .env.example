# No key is required. The answer engine is chosen automatically:
# Claude if ANTHROPIC_API_KEY is set, else a local Ollama model if running, else extractive quotes.
# RAG_LLM=auto                 # auto | ollama | extractive | claude
# RAG_OLLAMA_MODEL=llama3.2
# RAG_OLLAMA_URL=http://localhost:11434

# Optional: enables Claude as the answer engine
ANTHROPIC_API_KEY=

# Optional overrides
# RAG_MODEL=claude-opus-5-5
# RAG_EFFORT=medium            # low | medium | high | xhigh | max
# RAG_EMBEDDINGS=fastembed     # fastembed | none (BM25 only)
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_DATA_DIR=data
# RAG_TOP_K=6
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
